<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_mac8_sim.wdb" id="1">
         <top_modules>
            <top_module name="tb_ecg_mac8_sim" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="150.000 ns"></ZoomEndTime>
      <Cursor1Time time="60.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="220"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="10" />
   <wvobject type="separator" fp_name="divider1">
      <obj_property name="label">=== CLOCK &amp; RESET ===</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ecg_mac8_sim/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ecg_mac8_sim/rst_n">
      <obj_property name="ElementShortName">rst_n</obj_property>
      <obj_property name="ObjectShortName">rst_n</obj_property>
   </wvobject>
   <wvobject type="separator" fp_name="divider2">
      <obj_property name="label">=== CONTROL &amp; ACT INPUT ===</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ecg_mac8_sim/clear">
      <obj_property name="ElementShortName">clear</obj_property>
      <obj_property name="ObjectShortName">clear</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ecg_mac8_sim/acc">
      <obj_property name="ElementShortName">acc</obj_property>
      <obj_property name="ObjectShortName">acc</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ecg_mac8_sim/act">
      <obj_property name="ElementShortName">act[7:0]</obj_property>
      <obj_property name="ObjectShortName">act[7:0]</obj_property>
      <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="separator" fp_name="divider3">
      <obj_property name="label">=== 8-LANE PSUM OUTPUTS ===</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ecg_mac8_sim/psum">
      <obj_property name="ElementShortName">psum[0:7][23:0]</obj_property>
      <obj_property name="ObjectShortName">psum[0:7][23:0]</obj_property>
      <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
      <obj_property name="isExpanded"></obj_property>
   </wvobject>
</wave_config>
